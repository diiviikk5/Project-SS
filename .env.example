# SarkariSaathi Environment Variables
# Copy this file to .env and fill in your actual API keys

# ===== VAPI (Required for Voice Calls) =====
# Get your keys from: https://dashboard.vapi.ai/
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# ===== OpenRouter AI (Required) =====
# Get your key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# ===== Deepgram (Required) =====
# Get your key from: https://console.deepgram.com
VITE_DEEPGRAM_API_KEY=your_deepgram_key_here

# ===== ElevenLabs (Required) =====
# Get your key from: https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=your_elevenlabs_key_here
VITE_ELEVENLABS_VOICE_ID_EN=your_english_voice_id_here
VITE_ELEVENLABS_VOICE_ID_HI=your_hindi_voice_id_here

# ===== Twilio (Optional - for actual phone calls) =====
# Get your credentials from: https://console.twilio.com
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_token_here
# TWILIO_PHONE_NUMBER=+1234567890
